# Topograph sur Infomaniak (déployé par .github/workflows/infomaniak.yml)
# HTTPS obligatoire, et www.topograph.ch -> topograph.ch
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://topograph.ch%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://topograph.ch%{REQUEST_URI} [R=301,L]

# compression (repris de la configuration d'Infomaniak)
SetOutputFilter DEFLATE
AddOutputFilterByType DEFLATE application/javascript application/json text/css text/html text/javascript text/plain image/svg+xml application/xml

# cache : les fichiers construits portent une empreinte dans leur nom ; la page d'accueil est toujours relue
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|svg|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(index\.html|version\.txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# en-têtes de sécurité (audit du 27.11.2026) : appliqués ; la politique de contenu (CSP) est d'abord en mode « rapport
# seulement » pour vérifier qu'elle ne bloque rien (services swisstopo, cantons, AWS), avant de l'imposer
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://fundingchoicesmessages.google.com https://*.gstatic.com https://*.adtrafficquality.google; worker-src 'self' blob:; connect-src 'self' https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://fundingchoicesmessages.google.com https://*.gstatic.com https://*.adtrafficquality.google https://*.geo.admin.ch https://geodienste.ch https://www.ogc.vd.ch https://elevation-tiles-prod.s3.amazonaws.com; img-src 'self' data: blob: https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://fundingchoicesmessages.google.com https://*.gstatic.com https://*.adtrafficquality.google https://*.geo.admin.ch https://geodienste.ch https://www.ogc.vd.ch https://elevation-tiles-prod.s3.amazonaws.com; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://fundingchoicesmessages.google.com https://*.gstatic.com https://*.adtrafficquality.google; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com"
</IfModule>

# protection git
RedirectMatch 404 /\.git
